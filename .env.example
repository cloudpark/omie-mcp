# Credenciais da API do OMIE — Configurações → API → Aplicações
OMIE_APP_KEY=your_app_key_here
OMIE_APP_SECRET=your_app_secret_here

# Nível de escrita no ERP. Omitir = off (somente leitura).
# As ferramentas não autorizadas não são registradas no servidor.
#   off  somente leitura                                     25 tools
#   on   + incluir/alterar/lancar (cria, edita, dá baixa)     36 tools
#   all  + excluir/cancelar (apaga títulos, estorna baixas)   41 tools
# OMIE_WRITE_MODE=off

# Se você criar este arquivo à mão, restrinja a permissão:
#   chmod 600 ~/.config/omie-mcp/.env
